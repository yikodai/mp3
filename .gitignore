.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
credentials
credentials.*
secrets
secrets.*

# ---- 虚拟环境 / 依赖 ----
.venv/
venv/
env/
ENV/
node_modules/

